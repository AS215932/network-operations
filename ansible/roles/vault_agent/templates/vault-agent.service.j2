# /etc/systemd/system/vault-agent-{{ vault_agent_name }}.service
# Managed by ansible/roles/vault_agent.

[Unit]
Description=Vault Agent for {{ vault_agent_name }}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group={{ vault_agent_service_group }}
{# Recreate the consumer's volatile (/run) dirs on boot — tmpfs is wiped.
   Persistent dirs (e.g. /etc/*) are handled by the role's file task. #}
{% for d in vault_agent_extra_dirs if d.path.startswith('/run/') %}
ExecStartPre=/bin/mkdir -p {{ d.path }}
ExecStartPre=/bin/chgrp {{ d.group | default('root') }} {{ d.path }}
ExecStartPre=/bin/chmod {{ d.mode | default('0750') }} {{ d.path }}
{% endfor %}
ExecStart=/usr/bin/vault agent -config={{ vault_agent_config_dir }}/{{ vault_agent_name }}.hcl
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
{# One /run/vault-agent holds the token sink of EVERY agent on the host, so it
   must outlive any single unit. With the systemd default
   (RuntimeDirectoryPreserve=no) the directory is deleted whenever any one agent
   stops, taking every sibling's sink with it — the siblings keep running and
   stay authenticated, but mon reads the sink and reports them as holding no
   Vault token. Observed on loop 2026-07-30: restarting all four agents in
   sequence left only the last one's sink on disk. #}
RuntimeDirectory=vault-agent
RuntimeDirectoryPreserve=yes
RuntimeDirectoryMode={{ vault_agent_run_dir_mode }}
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes

[Install]
WantedBy=multi-user.target
