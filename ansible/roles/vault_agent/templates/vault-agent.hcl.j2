# {{ vault_agent_config_dir }}/{{ vault_agent_name }}.hcl
# Managed by ansible/roles/vault_agent.

pid_file = "{{ vault_agent_run_dir }}/{{ vault_agent_name }}.pid"

vault {
  address = "{{ vault_agent_vault_addr }}"
{% if vault_agent_vault_tls_skip_verify | bool %}
  tls_skip_verify = true
{% endif %}

  retry {
    num_retries = 12
  }
}

auto_auth {
  method "approle" {
    mount_path = "auth/approle"

    config = {
      role_id_file_path = "{{ vault_agent_role_id_file }}"
      secret_id_file_path = "{{ vault_agent_secret_id_file }}"
{% set response_wrapping_path = vault_agent_effective_secret_id_response_wrapping_path | default(vault_agent_secret_id_response_wrapping_path) %}
{% if response_wrapping_path | length > 0 %}
      # WRAPPED (single-use) mode. Vault Agent unwraps the token once and then
      # DELETES {{ vault_agent_secret_id_file }}. The next restart of this unit
      # — reboot, `apt upgrade vault`, OOM kill, deploy — has no credential and
      # the agent enters a permanent 403 backoff loop while systemd still
      # reports the unit active. Re-bootstrapping needs a human with a fresh
      # wrapped SecretID inside the wrap TTL, and the agent must be STOPPED
      # before the new token is installed or it consumes it mid-retry-loop.
      # Prefer the durable shape below: see
      # docs/runbooks/vault-agent-durable-auth.md.
      secret_id_response_wrapping_path = "{{ response_wrapping_path }}"
      remove_secret_id_file_after_reading = true
{% else %}
      # DURABLE mode. The SecretID persists 0600 on disk, so authentication
      # survives every restart. This is only safe when the AppRole is created
      # with secret_id_num_uses=0, secret_id_ttl=0 and — as the compensating
      # control for a credential at rest — secret_id_bound_cidrs /
      # token_bound_cidrs pinned to this host's address.
      remove_secret_id_file_after_reading = false
{% endif %}
    }
  }

  sink "file" {
    config = {
      path = "{{ vault_agent_token_sink }}"
      mode = {{ vault_agent_token_sink_mode }}
    }
  }
}

{% for t in vault_agent_templates %}
template {
  source      = "{{ vault_agent_template_dir }}/{{ t.name }}"
  destination = "{{ t.destination }}"
{% set destination_mode = t.mode | default('0640') %}
  perms       = {{ destination_mode }}
{% set render_command = "/bin/sh -c 'chgrp " ~ t.group ~ " " ~ t.destination ~ " && chmod " ~ destination_mode ~ " " ~ t.destination ~ " && " ~ t.reload_command ~ "'" %}
  command     = {{ render_command | to_json }}

  wait {
    min = "2s"
    max = "10s"
  }
}
{% if not loop.last %}

{% endif %}
{% endfor %}
