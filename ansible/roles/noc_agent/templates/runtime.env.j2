# Non-secret runtime controls. Loaded after the Vault-managed credential file.
# Retirement switches must take effect even while Vault is sealed.
NOC_ENGINEERING_HANDOFF_DELIVERY_ENABLED={{ '1' if noc_engineering_handoff_delivery_enabled | bool else '0' }}
NOC_DISK_ALERT_HANDOFF_ENABLED={{ '1' if noc_disk_alert_handoff_enabled | bool else '0' }}
HYRULE_NOC_AGENT_CORE_TRACE={{ '1' if noc_agent_core_trace_enabled | bool else '0' }}
HYRULE_NOC_AGENT_CORE_TRACE_COLLECTOR_URL="{{ noc_agent_core_trace_collector_url }}"
NOC_PROACTIVE_HANDOFF_ENABLED=0
NOC_INSIGHT_RECORDS_ENABLED=0

# Durable reporting ownership; independent of credential-template refresh.
NOC_CASESERVICE_REACTIVE_REPORT={{ '1' if noc_case_reactive_report_enabled | bool else '0' }}
NOC_CASE_ATTENTION_ENABLED={{ '1' if noc_case_attention_enabled | bool else '0' }}
NOC_CASE_OUTBOX_ENABLED={{ '1' if noc_case_outbox_enabled | bool else '0' }}
