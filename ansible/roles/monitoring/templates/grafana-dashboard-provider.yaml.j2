---
# {{ ansible_managed }}
# Deploy to: {{ monitoring_grafana_provisioning_dir }}/dashboards/hyrule.yaml on mon
# Source: ansible/roles/monitoring/templates/grafana-dashboard-provider.yaml.j2
#
# Loads every dashboard JSON the role publishes into
# {{ monitoring_grafana_dashboard_dir }}. Grafana re-reads that directory every
# updateIntervalSeconds, so a dashboard change needs no Grafana restart.
#
# allowUiUpdates: false means the UI cannot *save* over a provisioned dashboard.
# Editing and exploring still work — to keep a change, use Export → JSON and
# commit it to configs/mon/grafana-dashboards/, which is the source of truth.
apiVersion: 1

providers:
  - name: hyrule
    orgId: 1
    folder: Hyrule
    type: file
    disableDeletion: false
    updateIntervalSeconds: 30
    allowUiUpdates: false
    options:
      path: {{ monitoring_grafana_dashboard_dir }}
      foldersFromFilesStructure: false
